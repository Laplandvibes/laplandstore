[
  {
    "path": "/",
    "fallbackTitle": "LaplandStore, Authentic Lapland Products: Crafts, Jewelry & Delicacies",
    "fallbackDescription": "A curated directory of verified Lapland boutiques: handicrafts, jewelry and delicacies direct from real makers in Finnish Lapland. Support local makers.",
    "harvestFiles": [
      "src/pages/Home.tsx",
      "src/components/Hero.copy.{lang}.ts",
      "src/components/LocalShops.copy.{lang}.ts",
      "src/components/Newsletter.copy.{lang}.ts",
      "src/components/ArtisanStory.tsx",
      "src/components/FAQ.tsx"
    ]
  },
  {
    "path": "/privacy",
    "fallbackTitle": "Privacy Policy | LaplandStore",
    "harvestFiles": [
      "src/shared/Legal/PrivacyContent.tsx"
    ]
  },
  {
    "path": "/terms",
    "fallbackTitle": "Terms of Use | LaplandStore",
    "harvestFiles": [
      "src/shared/Legal/TermsContent.tsx",
      "src/pages/Terms.tsx"
    ]
  },
  {
    "path": "/cookie-policy",
    "fallbackTitle": "Cookie Policy | LaplandStore",
    "harvestFiles": [
      "src/shared/Legal/CookieContent.tsx",
      "src/pages/CookiePolicy.tsx"
    ]
  }
]
